# Copy this file to .env (which git ignores) and fill in the values to test real
# Telegram alerts and sheet rows locally with tools/dev-server.js. On the live site
# the same names are set in Netlify → Site configuration → Environment variables.
# Leave a line empty to skip that channel.

# Business Telegram (the existing order bot and chat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Developer Telegram. The bot token is only needed if it's a different bot.
TELEGRAM_DEV_CHAT_ID=
TELEGRAM_DEV_BOT_TOKEN=

# Google order sheet (the /exec web-app address and the TOKEN from orders.gs)
SHEET_WEBHOOK_URL=
SHEET_TOKEN=

# What's really sent while testing with ?send=real (true or false; missing = true).
# Turn off what you don't need to save FormSubmit quota. Restart the server after a change.
SEND_ORDER_EMAILS=true
SEND_CONTACT_EMAILS=true
SEND_VISIT_EMAILS=false
SEND_ORDER_TELEGRAM=true
SEND_CONTACT_TELEGRAM=true
SEND_ORDER_SHEET=true
