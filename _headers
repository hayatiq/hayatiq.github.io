# How long browsers keep files (Netlify). Pages themselves keep Netlify's default:
# checked on every visit, so a deploy shows straight away.

# Photos: kept for 7 days. A replaced photo needs a new file name, or some visitors
# keep seeing the old one for up to a week.
/images/*
  Cache-Control: public, max-age=604800

# Fonts: kept for a year; a new version of a font gets a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# css/ and js/ files are also kept for a year: tools/asset-versions.js adds their
# rules below at deploy, after giving each one a ?v= version in index.html.
